<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>spot_flex_perception</name>
  <version>0.1.0</version>
  <description>Object detection and localization for spot_flex</description>
  <maintainer email="timothy.duggan@tufts.edu">Timothy Duggan</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>bosdyn_api_msgs</depend>
  <depend>spot_flex_msgs</depend>
  <depend>spot_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>image_transport</depend>

  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
