<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>spot_flex_sim</name>
  <version>0.1.0</version>
  <description>Gazebo Fortress simulation for Spot with full camera suite for SLAM and Nav2 testing</description>
  <maintainer email="trd44@pitt.edu">Timothy Duggan</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>spot_gazebo</exec_depend>
  <exec_depend>spot_description</exec_depend>
  <exec_depend>spot_bringup</exec_depend>
  <exec_depend>champ_config</exec_depend>
  <exec_depend>champ_base</exec_depend>
  <exec_depend>spot_flex_nav</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
