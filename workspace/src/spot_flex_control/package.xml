<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>spot_flex_control</name>
  <version>0.1.0</version>
  <description>Navigation, arm control, and policy execution for spot_flex</description>
  <maintainer email="timothy.duggan@tufts.edu">Timothy Duggan</maintainer>
